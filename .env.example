# Copy this file to ".env" and fill in your key.
# .env is git-ignored so your key is never committed.

ANTHROPIC_API_KEY=sk-ant-...

# Model to use (Claude).
CLAUDE_MODEL=claude-sonnet-5
# Anthropic requires max_tokens; default is high (8192). Override if you want.
# CLAUDE_MAX_TOKENS=8192

# --- Database selection ---
# "sqlite" (default demo) or "mssql" (real SQL Server).
DB_KIND=sqlite
SQLITE_FILE=demo.db

# --- SQL Server (fill in tomorrow; use a READ-ONLY user, target beta not prod) ---
# DB_KIND=mssql
# MSSQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;DATABASE=OnlineApps;UID=readonly_user;PWD=...;TrustServerCertificate=yes

# Optional empty-state greeting name, e.g. tarun-g → "What's cooking, tarun-g?"
# ASK_USER_NAME=tarun-g

# --- Query guardrails ---
# Most rows a single answer may return (0 = no cap).
MAX_ROWS=500
# Seconds before a SQL Server query is cancelled.
QUERY_TIMEOUT=30
